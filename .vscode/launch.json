{
	"configurations": [
		{
			"type": "gdb",
			"request": "attach",
			"name": "Attach to gdbserver",
			"executable": "${workspaceFolder}/build/nucleo-g491re-usb-cw-iface.elf",
			"target": ":3333",
			"remote": true,
			"cwd": "${workspaceRoot}",
			"valuesFormatting": "parseText",
			"autorun": [
				"monitor reset halt",
				"monitor flash write_image erase ${workspaceFolder}/build/nucleo-g491re-usb-cw-iface.elf",
				"monitor reset halt",
				"enable breakpoint"
			]
		},
	],
	"version": "2.0.0"
}